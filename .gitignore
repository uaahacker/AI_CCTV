# =====================================================================
# AI CCTV Analytics — .gitignore
# Hardened for a PUBLIC GitHub repository. Anything that could leak
# secrets, customer data, real RTSP credentials, or build noise stays out.
# =====================================================================

# --- Secrets / env (NEVER commit) -------------------------------------
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.crt
*.p12
*.pfx
*.cer
secrets/
**/secrets.*

# --- Python -----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.python-version
.venv/
venv/
env/
ENV/

# --- Django -----------------------------------------------------------
*.log
logs/
*.sqlite3
*.sqlite3-journal
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
local_settings.py

# --- Node / React / Vite ----------------------------------------------
node_modules/
dist/
build/
.vite/
.next/
.parcel-cache/
.cache/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Docker -----------------------------------------------------------
*.pid
docker-compose.override.yml

# --- IDE / OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- ML models / video / clips (NEVER commit binaries) ----------------
*.pt
*.onnx
*.weights
*.tflite
*.h5
*.pb
*.mp4
*.avi
*.mov
*.mkv
clips/
recordings/
snapshots/

# --- TLS certs / nginx mounts ----------------------------------------
infra/nginx/certs/*
!infra/nginx/certs/.gitkeep

# --- Misc -------------------------------------------------------------
*.bak
*.tmp
schema.yml
