# =====================================================================
# Root .env consumed by docker-compose.yml. Copy to .env and edit.
#
# IMPORTANT — this file is committed to git as an EXAMPLE.
#   - Never commit your real .env
#   - Every value below is a PLACEHOLDER; replace before deploying
#   - Generate SECRET_KEY:        python -c "import secrets; print(secrets.token_urlsafe(64))"
#   - Generate FIELD_ENCRYPTION_KEY:
#       python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =====================================================================

# --- Django ---
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Fernet key used to encrypt RTSP URLs AND AI provider API keys at rest.
# Losing this key makes those values unrecoverable. Back it up offline.
FIELD_ENCRYPTION_KEY=

# --- Database (compose-internal hostnames) ---
POSTGRES_DB=cctv
POSTGRES_USER=cctv
POSTGRES_PASSWORD=replace-with-strong-random-password
DATABASE_URL=postgres://cctv:replace-with-strong-random-password@db:5432/cctv

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- CORS / frontend ---
# In production set this to your real domain, e.g. https://cctv.example.com
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
# Leave empty so the React build talks to same-origin /api (proxied by nginx).
VITE_API_BASE=

# --- Email (console backend by default in compose) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=alerts@example.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Alerts ---
ALERT_COOLDOWN_SECONDS=300

# --- SMS / Twilio (optional) ---
# Leave blank to run the SMS adapter in mock mode (logs only, never sends).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Privacy / Compliance ---
# Face blur is ON by default. Set to False ONLY with a documented legal basis.
PRIVACY_BLUR_FACES=True
# Facial recognition is OFF by default. Do not enable without explicit consent.
PRIVACY_FACIAL_RECOGNITION_ENABLED=False
# Bump when terms text changes — invalidates older consent records.
CONSENT_TERMS_VERSION=1.0

# --- CV worker ---
# DETECTOR=yolo runs real person + vehicle detection (CPU-friendly YOLOv8n).
# Set DETECTOR=dummy if you only want a synthetic sine-wave count for demos.
DETECTOR=yolo
SAMPLE_INTERVAL_SECONDS=5
CAMERA_REFRESH_SECONDS=30
RTSP_READ_TIMEOUT_SECONDS=10
RECONNECT_BACKOFF_SECONDS=15
MAX_CAMERAS=64
DUMMY_MAX_PEOPLE=15
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.35

# =====================================================================
# AI / LLM provider notes
# ---------------------------------------------------------------------
# AI providers are configured PER ORGANIZATION from the dashboard
# (Settings → AI Settings), NOT from this file. The API keys you paste
# in the dashboard are encrypted at rest using FIELD_ENCRYPTION_KEY.
#
# Supported provider types:
#   - openrouter         → base URL https://openrouter.ai/api/v1
#   - openai_compatible  → any OpenAI-compatible cloud endpoint
#   - local_ollama       → http://ollama:11434/v1  (use docker compose --profile local-ai)
#   - self_hosted        → vLLM / LM Studio / text-generation-webui
#   - disabled           → no AI, deterministic fallback summaries
#
# See AI_PROVIDERS.md for safe-configuration examples.
# =====================================================================
