# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL). For quick local dev you can leave DATABASE_URL empty
# and the app will fall back to SQLite.
DATABASE_URL=postgres://cctv:cctv@localhost:5432/cctv

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS (React dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Encryption key for RTSP URLs at rest (Fernet key, base64 32 bytes).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Email (use console backend in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=alerts@aicctv.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Alert cooldown — minimum seconds between duplicate alerts for same rule
ALERT_COOLDOWN_SECONDS=300
