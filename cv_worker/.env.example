# Path to backend project root (used to import the Django app).
# In Docker we'll mount/copy it; in dev keep relative.
BACKEND_PATH=../backend
DJANGO_SETTINGS_MODULE=config.settings

# Must mirror backend/.env so the worker reads the same DB and can decrypt
# the rtsp_url_encrypted column.
DATABASE_URL=postgres://cctv:cctv@localhost:5432/cctv
FIELD_ENCRYPTION_KEY=
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Worker tuning ---
# Which detector to use: dummy | yolo
DETECTOR=yolo
# Seconds between detection samples per camera (avoids hammering DB).
SAMPLE_INTERVAL_SECONDS=5
# Seconds between full camera-list refreshes from DB.
CAMERA_REFRESH_SECONDS=30
# Frame read timeout / reconnect backoff.
RTSP_READ_TIMEOUT_SECONDS=10
RECONNECT_BACKOFF_SECONDS=15
# Hard cap on concurrent camera threads.
MAX_CAMERAS=64

# When DETECTOR=dummy, this controls the synthetic count amplitude.
DUMMY_MAX_PEOPLE=15

# When DETECTOR=yolo, the model weights to use (downloaded on first run).
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.35


# Error monitoring (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
